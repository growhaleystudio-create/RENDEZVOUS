---
import { faqs } from "../../data/demo-content.js";
import SectionHeading from "./SectionHeading.astro";
---

<section id="faq" class="editorial-section faq-section" aria-labelledby="faq-heading">
	<div class="editorial-shell faq-section__layout">
		<SectionHeading
			sectionId="faq"
			index="08"
			eyebrow="Tanya jawab"
			title="Sebelum berkunjung."
		/>
		<div class="faq-list">
			{faqs.map((faq, index) => (
				<details class="faq-item">
					<summary><span>0{index + 1}</span>{faq.question}</summary>
					<p>{faq.answer}</p>
				</details>
			))}
		</div>
	</div>
</section>
