---
import { ArrowUpRightIcon } from "@phosphor-icons/react/dist/ssr/ArrowUpRight";
import PrototypeLink from "./PrototypeLink.astro";

interface Props {
  href: string;
  label: string;
  variant?: "primary" | "secondary";
  size?: "default" | "compact";
  block?: boolean;
  class?: string;
}

const { href, label, variant = "primary", size = "default", block = false, class: className } = Astro.props;
const buttonClass = [
	"button",
	`button--${variant}`,
	size === "compact" && "button--compact",
	block && "button--block",
	className,
].filter(Boolean).join(" ");
---


<PrototypeLink
	href={href}
	class={buttonClass}
>
	<span>{label}</span>
	<ArrowUpRightIcon size={18} weight="regular" aria-hidden="true" />
</PrototypeLink>
