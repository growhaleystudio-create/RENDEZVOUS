---
import EditorialButton from "./EditorialButton.astro";

interface Props {
  bookingUrl: string;
}

const { bookingUrl } = Astro.props;
---

<section class="campaign-hero" aria-labelledby="hero-title" id="top">
  <div class="editorial-shell campaign-hero__heading">
    <h1 id="hero-title"><span class="motion-line"><span>A good cut.</span></span><span class="motion-line"><span>A better day.</span></span></h1>
    <div class="campaign-hero__intro">
      <p class="campaign-hero__lead">Barbershop untuk potongan yang dibuat sesuai kamu, bukan tren.</p>
      <EditorialButton href={bookingUrl} label="Booking sekarang" class="campaign-hero__cta" />
    </div>
  </div>
  <div class="campaign-hero__diptych">
    <figure class="campaign-hero__portrait">
      <img src="/images/photography/hero-finished-cut.webp" alt="Hasil potongan rambut dengan belahan samping dan fade yang rapi." width="1800" height="1200" fetchpriority="high" />
    </figure>
    <figure class="campaign-hero__detail">
      <img src="/images/photography/haircut-action.webp" alt="Barber memotong rambut menggunakan sisir dan gunting." width="1800" height="2250" />
    </figure>
  </div>
</section>
